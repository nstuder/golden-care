# Used to encrypt JWT tokens – generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Public URL of the site, no trailing slash (CORS, links, ...)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Local dev: MongoDB from docker-compose.dev.yml
DATABASE_URL=mongodb://127.0.0.1:27018/golden-care

# Production only: credentials for the MongoDB container.
# docker-compose.yml builds DATABASE_URL from these values.
MONGO_USERNAME=golden-care
MONGO_PASSWORD=CHANGE_ME
MONGO_DATABASE=golden-care
