{
  "name": "golden-care",
  "version": "1.0.0",
  "description": "Golden Care – Hundecoiffeur",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "deploy": "ansible-playbook -i ./deploy/hosts ./deploy/deploy-playbook.yml"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "@payloadcms/ui": "3.94.1",
    "clsx": "2.1.1",
    "cross-env": "10.1.0",
    "graphql": "^16.15.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.1"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.7.3"
  }
}
